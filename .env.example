# Optional AI explanation (server-side only; never expose this key to the browser)
NEARAI_API_KEY=
OUTCOME_AI_RATE_LIMIT_PER_HOUR=5

# Database backend: sqlite for local development, turso for Vercel deployment
OUTCOME_DB_BACKEND=sqlite

# Required when OUTCOME_DB_BACKEND=turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional local data directory (SQLite only)
# OUTCOME_DATA_DIR=./data

# Keep destructive reset disabled except in disposable local environments.
# Even when enabled, reset deletes only the legacy shared rows. Personal and guided-demo workspaces stay.
OUTCOME_ALLOW_DEMO_RESET=false

# Public testnet settings. Do not put a private key, seed, or full-access key here.
OUTCOME_NEAR_NETWORK=testnet
OUTCOME_NEAR_CONTRACT_ID=thewordweaver.testnet
OUTCOME_NEAR_RPC_URL=https://rpc.testnet.near.org

# Optional limits and demo lifetime
# OUTCOME_WRITE_RATE_LIMIT_PER_HOUR=240
# OUTCOME_DEMO_RATE_LIMIT_PER_HOUR=20
# OUTCOME_AUTH_RATE_LIMIT_PER_HOUR=30
# OUTCOME_ANCHOR_RATE_LIMIT_PER_HOUR=15
# OUTCOME_TRIAL_TTL_HOURS=24
