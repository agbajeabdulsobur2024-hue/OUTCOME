# Optional AI explanation (server-side only; never expose this key to the browser)
NEARAI_API_KEY=
OUTCOME_AI_RATE_LIMIT_PER_HOUR=5

# Database backend: sqlite for local development, turso for Vercel deployment
OUTCOME_DB_BACKEND=sqlite

# Required when OUTCOME_DB_BACKEND=turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional local data directory (SQLite only)
# OUTCOME_DATA_DIR=./data

# Keep destructive reset disabled except in disposable local environments
OUTCOME_ALLOW_DEMO_RESET=false
